---
import Hero from '../components/Hero.astro';
import ImpactMetrics from '../components/ImpactMetrics.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import CaseStudies from '../components/CaseStudies.astro';
import SkillsSection from '../components/SkillsSection.astro';
import EducationSection from '../components/EducationSection.astro';
import ContactSection from '../components/ContactSection.astro';
---

---

<div class="min-h-screen">
  <main class="pt-24 pb-12">
    <section class="py-12 lg:py-16">
      <Hero />
    </section>

    <section id="impact" class="py-12 lg:py-16 bg-white lg:bg-gray-50 dark:bg-gray-900 dark:text-white">
      <div class="container">
        <ImpactMetrics />
      </div>
    </section>

    <section id="experience" class="py-12 lg:py-16">
      <div class="container">
        <ExperienceTimeline />
      </div>
    </section>

    <section id="case-studies" class="py-12 lg:py-16 bg-white lg:bg-gray-50 dark:bg-gray-900 dark:text-white">
      <div class="container">
        <CaseStudies />
      </div>
    </section>

    <section id="skills" class="py-12 lg:py-16">
      <div class="container">
        <SkillsSection />
      </div>
    </section>

    <section id="education" class="py-12 lg:py-16 bg-white lg:bg-gray-50 dark:bg-gray-900 dark:text-white">
      <div class="container">
        <EducationSection />
      </div>
    </section>

    <section id="contact" class="py-12 lg:py-16">
      <div class="container">
        <ContactSection />
      </div>
    </section>
  </main>
</div>