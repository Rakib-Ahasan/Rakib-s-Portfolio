---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Impact from '../components/Impact.astro';
import Flow from '../components/Flow.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import portfolio from '../data/portfolio.json';
---

<Layout>
  <Nav />
  <main id="main">
	<Hero profile={portfolio.profile} />
	<Impact metrics={portfolio.metrics} />
	<Flow flow={portfolio.flow} />
	<Experience experience={portfolio.experience} />
	<Projects projects={portfolio.projects} />
	<Skills skills={portfolio.skills} />
	<Education education={portfolio.education} certifications={portfolio.certifications} />
	<Contact profile={portfolio.profile} contact={portfolio.contact} />
  </main>
  <Footer />
</Layout>
