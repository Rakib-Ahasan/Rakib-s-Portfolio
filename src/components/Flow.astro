---
const { flow } = Astro.props;
---
<section id="flow" class="section border-y border-[var(--line)]" data-reveal><div class="container"><div class="section-heading"><div class="eyebrow">02 / request path</div><h2>How I make it fast.</h2><p>Trace the work from client request to useful response. Hover or tap a node for the optimization lens.</p></div><div class="grid gap-5 lg:grid-cols-[1.2fr_.8fr] lg:items-center"><div class="card overflow-hidden p-5"><div class="flex flex-col items-stretch gap-3 md:flex-row md:items-center md:gap-2">{flow.map((node, index) => <><button class="flow-node card-hover flex flex-1 flex-col items-start p-4 text-left" data-flow={index} type="button"><span class="mono text-xs text-[var(--accent)]">{node.short}</span><strong class="mt-2 text-sm">{node.name}</strong></button>{index < flow.length - 1 && <span class="mono hidden self-center text-[var(--accent)] md:block">→</span>}</>)}</div><div class="mt-5 rounded-lg border border-[var(--line)] bg-[var(--bg)] p-4"><p class="mono text-xs leading-relaxed text-[var(--muted)]" id="flow-detail">{flow[0].detail}</p></div></div><div class="card p-6"><div class="eyebrow">before / after</div><div class="mt-6 space-y-5"><div><div class="mb-2 flex justify-between mono text-xs"><span>before · hot grid</span><span>110s</span></div><div class="h-3 overflow-hidden rounded-full bg-[var(--surface-strong)]"><div class="h-full w-full rounded-full bg-[#ef6a6a]"></div></div></div><div><div class="mb-2 flex justify-between mono text-xs"><span>after · tuned path</span><span>9–13s</span></div><div class="h-3 overflow-hidden rounded-full bg-[var(--surface-strong)]"><div class="h-full w-[12%] rounded-full bg-[var(--accent)]"></div></div></div></div></div></div></div></section>
<script define:vars={{ details: flow.map((node) => node.detail) }}>
  const flowNodes = document.querySelectorAll('[data-flow]');
  flowNodes.forEach((node) => node.addEventListener('click', () => { const detail = document.querySelector('#flow-detail'); if (detail) detail.textContent = details[Number(node.getAttribute('data-flow'))] || ''; flowNodes.forEach((item) => item.classList.toggle('border-[var(--line-strong)]', item === node)); }));
</script>
