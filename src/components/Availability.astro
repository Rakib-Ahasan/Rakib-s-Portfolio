---
import { profile } from '../data/portfolio.json';
const avail = profile.availability;
---

<section class="border-y border-[var(--line)] bg-[var(--bg)]/50">
  <div class="container py-4 md:py-5">
	<div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-[var(--muted)]">
	  <span class="inline-flex items-center gap-2">
		<svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
		  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
		</svg>
		<span>{avail.visaSponsorship}</span>
	  </span>

	  <span class="inline-flex items-center gap-2">
		<svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
		  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
		</svg>
		<span>Notice: {avail.noticePeriod}</span>
	  </span>

	  <span class="inline-flex items-center gap-2">
		<svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
		  <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/>
		</svg>
		<span>{avail.timezoneFlexibility}</span>
	  </span>

	  <span class="inline-flex items-center gap-2">
		<svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
		  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
		</svg>
		<span class="mono text-xs">
		  {avail.languages.map((language) => `${language.language} (${language.level})`).join(' · ')}
		</span>
	  </span>
	</div>
  </div>
</section>
