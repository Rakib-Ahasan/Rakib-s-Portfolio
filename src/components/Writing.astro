---
const { articles = [] } = Astro.props;
---
<section id="writing" class="section" data-reveal>
  <div class="container">
	<div class="section-heading">
	  <div class="eyebrow">WRITING</div>
	  <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2">Notes from the engineering path.</h2>
	</div>
	{articles.length ? <div class="grid gap-4 md:grid-cols-2">{articles.map((article) => <article class="rounded-lg border border-[var(--line)] p-6 transition hover:border-[var(--accent)]"><h3 class="text-xl font-semibold tracking-tight"><a href={article.url} target="_blank" rel="noreferrer">{article.title}</a></h3><p class="mt-3 text-[var(--muted)]">{article.summary}</p><a class="mono mt-6 inline-block text-sm text-[var(--accent)]" href={article.url} target="_blank" rel="noreferrer">Read on dev.to →</a></article>)}</div> : <p class="text-[var(--muted)]">Articles coming soon. In the meantime, check my GitHub for code and architecture notes.</p>}
  </div>
</section>
