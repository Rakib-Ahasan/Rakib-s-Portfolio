---
const { writing = [] } = Astro.props;
---
{writing.length > 0 && <section id="writing" class="section" data-reveal>
  <div class="container">
	<div class="section-heading">
	  <div class="eyebrow">07 / writing</div>
	  <h2>Writing</h2>
	  <p>Notes on .NET, architecture and backend engineering.</p>
	</div>
	<div class="grid gap-4 md:grid-cols-2">
	  {writing.map((item) => <a class="card card-hover p-5" href={item.url} target="_blank" rel="noopener noreferrer">
		<h3 class="text-xl font-semibold tracking-tight" lang={item.lang === 'BN' ? 'bn' : undefined}>{item.title}</h3>
		<div class="mt-4 flex flex-wrap items-center gap-2">
		  <time class="mono text-xs text-[var(--muted)]" datetime={item.date}>{new Date(`${item.date}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</time>
		  <span class="rounded-full border border-[var(--line)] px-2 py-1 mono text-[.65rem] text-[var(--accent)]">{item.lang}</span>
		  {item.tags?.map((tag) => <span class="rounded-full border border-[var(--line)] px-2 py-1 mono text-[.65rem] text-[var(--muted)]">{tag}</span>)}
		</div>
	  </a>)}
	</div>
	<a class="btn btn-ghost mt-6" href="https://dev.to/rakibahasan" target="_blank" rel="noopener noreferrer">More on dev.to →</a>
  </div>
</section>}