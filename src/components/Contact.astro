---
const { profile, contact } = Astro.props;
---
<section id="contact" class="section" data-reveal><div class="container"><div class="card relative overflow-hidden p-7 md:p-12"><div class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-[var(--accent)] opacity-[.1] blur-3xl"></div><div class="relative grid gap-10 md:grid-cols-[1fr_auto] md:items-end"><div><div class="eyebrow">08 / open channel</div><h2 class="mt-3 max-w-xl text-4xl font-semibold tracking-[-.04em] md:text-5xl">Have a slow system or a hard integration?</h2><p class="mt-5 max-w-xl text-[var(--muted)]">{contact.replyNote}. Let’s talk about the constraint before the solution.</p></div><div class="flex flex-wrap gap-3 md:justify-end"><a class="rounded-lg bg-[var(--accent)] px-5 py-3 font-semibold text-[var(--bg)]" href={`mailto:${profile.email}`}>Email me</a><a class="rounded-lg border border-[var(--line-strong)] px-5 py-3 text-[var(--accent)]" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a class="rounded-lg border border-[var(--line)] px-5 py-3 text-[var(--muted)]" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a></div></div><div class="mono mt-10 flex flex-wrap gap-x-7 gap-y-2 border-t border-[var(--line)] pt-5 text-xs text-[var(--faint)]"><span>{profile.email}</span><span>{profile.phone}</span><span id="local-time">UTC+6 · local time</span></div></div></div></section>
<script is:inline>
  const clock = document.querySelector('#local-time'); const updateClock = () => { if (clock) clock.textContent = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Dhaka', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date()) + ' · Dhaka / UTC+6'; }; updateClock(); setInterval(updateClock, 60000);
</script>
