no mt-10 flex flex-wrap gap-x-7 gap-y-2 border-t border-[var(--line)] pt-5 text-xs text-[var(--faint)]"><span>{profile.email}</span><span>{profile.phone}</span><span id="local-time">UTC+6 · local time</span></div><p class="mt-8 text-xs text-[var(--muted)] mono">{profile.availability.noticePeriod} · {profile.availability.timezoneFlexibility}</p>
<script is:inline>
  const clock = document.querySelector('#local-time'); const updateClock = () => { if (clock) clock.textContent = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Dhaka', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date()) + ' · Dhaka / UTC+6'; }; updateClock(); setInterval(updateClock, 60000);
</script>
