---
const { education, certifications } = Astro.props;
---
<section id="education" class="section border-y border-[var(--line)]" data-reveal><div class="container grid gap-10 md:grid-cols-2"><div><div class="eyebrow">06. EDUCATION</div><h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2">Education</h2><div class="card mt-6 p-5"><h3 class="font-semibold">{education.degree}</h3><p class="mt-2 text-[var(--muted)]">{education.institution}</p><p class="mono mt-3 text-xs text-[var(--accent)]">{education.years} · CGPA {education.cgpa}</p></div></div><div><div class="eyebrow">CERTIFICATIONS</div><h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2">Certifications</h2><div class="card mt-6 p-5"><ul class="space-y-2">{certifications.map((item) => <li class="text-[var(--muted)]">{item}</li>)}</ul></div></div></div></section>
