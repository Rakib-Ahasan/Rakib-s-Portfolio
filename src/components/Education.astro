---
const { education, certifications } = Astro.props;
---
<section id="education" class="section border-y border-[var(--line)]" data-reveal><div class="container"><div class="section-heading"><div class="eyebrow">06 / foundations</div><h2 class="mt-3 text-3xl font-semibold tracking-tight">Education &amp; certifications</h2></div><div class="grid gap-10 md:grid-cols-2"><div><h3 class="mono text-xs uppercase tracking-wider text-[var(--accent)]">Education</h3><div class="card mt-6 p-5"><h4 class="font-semibold">{education.degree}</h4><p class="mt-2 text-[var(--muted)]">{education.institution}</p><p class="mono mt-3 text-xs text-[var(--accent)]">{education.years} · CGPA {education.cgpa}</p></div></div><div><h3 class="mono text-xs uppercase tracking-wider text-[var(--accent)]">Certifications</h3><div class="card mt-6 p-5"><ul class="space-y-2">{certifications.map((item) => <li class="text-[var(--muted)]">{item}</li>)}</ul></div></div></div></div></section>
