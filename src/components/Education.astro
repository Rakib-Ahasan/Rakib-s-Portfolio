---
const { education, certifications } = Astro.props;
---
<section id="education" class="section border-y border-[var(--line)]" data-reveal><div class="container grid gap-10 md:grid-cols-2"><div><div class="eyebrow">06 / foundations</div><h2 class="mt-3 text-3xl font-semibold tracking-tight">Education</h2><div class="card mt-6 p-5"><h3 class="font-semibold">{education.degree}</h3><p class="mt-2 text-[var(--muted)]">{education.institution}</p></div></div><div><div class="eyebrow">07 / signal</div><h2 class="mt-3 text-3xl font-semibold tracking-tight">Certifications</h2><div class="card mt-6 p-5">{certifications.length ? <ul class="space-y-2">{certifications.map((item) => <li class="text-[var(--muted)]">{item}</li>)}</ul> : <p class="text-[var(--muted)]">Certification details are not listed.</p>}</div></div></div></section>
