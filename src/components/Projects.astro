---
const { projects } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section id="projects" class="section border-y border-[var(--line)]" data-reveal><div class="container"><div class="section-heading"><div class="eyebrow">04. PROJECTS</div><h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2">Case studies from the hot path.</h2><p>Problem, approach, result. No theatre—just the engineering decisions that moved the system.</p></div><div class="grid gap-4 lg:grid-cols-2">{projects.map((project, index) => <article class={`card card-hover flex flex-col p-6 ${index === 0 ? 'lg:col-span-2' : ''}`} data-project-card><div class="flex items-start justify-between gap-4"><span class="eyebrow">{project.status}</span><span class="mono text-xs text-[var(--faint)]">case/{project.slug}</span></div>{project.coverImage ? <><span class="mono text-xs text-[var(--accent)] uppercase tracking-wider">{project.imageType === 'diagram' ? 'ARCHITECTURE' : project.imageType === 'screenshot' ? 'UI' : ''}</span><img src={`${base}${project.coverImage.replace(/^\//, '')}`} alt={project.title} loading="lazy" class="w-full aspect-[16/9] object-cover rounded-lg border border-[var(--line)] mb-5" /></> : <div class="w-full aspect-[16/9] rounded-lg border border-[var(--line)] bg-[var(--surface-strong)] flex items-center justify-center mb-5"><span class="mono text-4xl font-bold text-[var(--muted)] opacity-40">{project.title.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase()}</span></div>}<h3 class="mt-5 text-2xl font-semibold tracking-tight">{project.title}</h3><div class="mt-6 grid gap-5 text-sm text-[var(--muted)] md:grid-cols-3"><div><span class="mono text-xs text-[var(--accent)]">problem</span><p class="mt-2">{project.problem}</p></div><div><span class="mono text-xs text-[var(--accent)]">approach</span><p class="mt-2">{project.approach}</p></div><div><span class="mono text-xs text-[var(--accent)]">result</span><p class="mt-2">{project.result}</p></div></div><div class="mt-auto flex flex-wrap items-center gap-2 pt-7"><span class="mono mr-2 text-xs text-[var(--faint)]">{project.role}</span>{project.tech.map((tech) => <span class="rounded-full border border-[var(--line)] px-2.5 py-1 mono text-[.67rem] text-[var(--muted)]">{tech}</span>)}<button class="project-open ml-auto rounded-md border border-[var(--line-strong)] px-3 py-2 mono text-xs text-[var(--accent)]" type="button" data-project={project.slug}>Inspect ↗</button></div></article>)}</div></div></section>
<dialog id="project-dialog" class="w-[min(92vw,760px)] rounded-xl border border-[var(--line-strong)] bg-[var(--surface)] p-0 text-[var(--text)] backdrop:bg-black/70"><div class="p-6"><div class="flex justify-between gap-4"><span class="eyebrow">case study</span><button id="project-close" class="text-2xl text-[var(--muted)]" aria-label="Close project">×</button></div><div id="project-dialog-content" class="mt-5"></div></div></dialog>
<script define:vars={{ projects }}>
  const dialog = document.querySelector('#project-dialog'); const content = document.querySelector('#project-dialog-content');
  document.querySelectorAll('.project-open').forEach((button) => button.addEventListener('click', () => { const project = projects.find((item) => item.slug === button.getAttribute('data-project')); if (!project || !content || !dialog) return; content.innerHTML = `<h2 class="text-3xl font-semibold">${project.title}</h2><p class="mt-4 text-[var(--muted)]">${project.result}</p><div class="mt-6 rounded-lg border border-[var(--line)] bg-[var(--bg)] p-8 text-center mono text-xs text-[var(--faint)]">architecture / media slot<br>${project.media?.length ? 'Media available in the project data.' : 'Add media under public/media/projects/' + project.slug}</div>`; dialog.showModal(); }));
  document.querySelector('#project-close')?.addEventListener('click', () => dialog?.close());
</script>
