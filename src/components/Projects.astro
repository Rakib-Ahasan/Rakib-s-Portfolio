---
const { projects } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id="projects" class="section border-y border-[var(--line)]" data-reveal>
  <div class="container">
    <div class="section-heading">
      <div class="eyebrow">04. PROJECTS</div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2">
        Case studies from the hot path.
      </h2>
      <p>
        Problem, approach, result. No theatre—just the engineering decisions that
        moved the system.
      </p>
    </div>
    <div class="grid gap-12">
      {projects.map((project, index) => (
        <article
          class="card card-hover flex flex-col p-6"
          data-project-card
          data-project
        >
          <div class="mb-4 flex items-center justify-between gap-4">
            <span class="eyebrow rounded-full border border-[var(--line)] px-3 py-1 text-xs">{project.status}</span>
            <span class="mono text-xs text-[var(--faint)] opacity-60">
              case/{project.slug}
            </span>
          </div>
          {project.coverImage ? (
            <>
              <span class="mono text-xs text-[var(--accent)] uppercase tracking-wider">
                {project.imageType === 'diagram'
                  ? 'ARCHITECTURE'
                  : project.imageType === 'screenshot'
                  ? 'UI'
                  : ''}
              </span>
              <div class="w-full aspect-[16/9] max-h-[420px] overflow-hidden rounded-lg border border-[var(--line)] mb-4">
                <img
                  data-cover
                  src={`${base}/${project.coverImage.replace(/^\//, '')}`}
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover object-top"
                />
              </div>
              {project.media?.length > 1 && (
                <div class="grid grid-cols-5 gap-2 mb-5">
                  {project.media.map((thumb) => (
                    <button
                      type="button"
                      data-thumb={`${base}/${thumb.replace(/^\//, '')}`}
                      class="group aspect-video rounded border border-[var(--line)] overflow-hidden hover:border-[var(--accent)] transition-colors"
                      aria-label={`View ${project.title} screenshot`}
                    >
                      <img
                        src={`${base}/${thumb.replace(/^\//, '')}`}
                        alt=""
                        loading="lazy"
                        class="w-full h-full object-cover object-top"
                      />
                    </button>
                  ))}
                </div>
              )}
            </>
          ) : (
            <div class="w-full h-32 md:h-40 rounded-lg border border-[var(--line)] bg-[var(--surface-strong)] mb-5 flex items-center justify-between px-5 relative overflow-hidden">
              <div
                class="absolute inset-0 opacity-[0.03]"
                style={{
                  backgroundImage:
                    'repeating-linear-gradient(45deg, currentColor 0, currentColor 1px, transparent 0, transparent 12px)',
                }}
              ></div>
              <span class="relative mono text-2xl font-bold text-[var(--accent)] opacity-60">
                {project.title
                  .split(' ')
                  .filter((word) => /^[A-Z]/.test(word))
                  .map((word) => word[0])
                  .join('')
                  .slice(0, 2)
                  .toUpperCase()}
              </span>
            </div>
          )}
          <h3 class="mt-5 text-2xl font-semibold tracking-tight">
            {project.title}
          </h3>
          <div class="mt-6 grid gap-5 text-sm text-[var(--muted)] md:grid-cols-3">
            <div>
              <span class="mono text-xs text-[var(--accent)]">problem</span>
              <p class="mt-2">{project.problem}</p>
            </div>
            <div>
              <span class="mono text-xs text-[var(--accent)]">approach</span>
              <p class="mt-2">{project.approach}</p>
            </div>
            <div>
              <span class="mono text-xs text-[var(--accent)]">result</span>
              <p class="mt-2">{project.result}</p>
            </div>
          </div>
          <div class="mt-auto flex flex-wrap items-center gap-2 pt-7">
            <span class="mono mr-2 text-xs text-[var(--faint)]">
              {project.role}
            </span>
            {project.tech.map((tech) => (
              <span class="rounded-full border border-[var(--line)] px-2.5 py-1 mono text-[.67rem] text-[var(--muted)]">
                {tech}
              </span>
            ))}
            <button
              class="project-open ml-auto rounded-md border border-[var(--line-strong)] px-3 py-2 mono text-xs text-[var(--accent)]"
              type="button"
              data-project={project.slug}
            >
              View case study →
            </button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<dialog
  id="project-dialog"
  class="w-[min(92vw,760px)] rounded-xl border border-[var(--line-strong)] bg-[var(--surface)] p-0 text-[var(--text)] backdrop:bg-black/70"
>
  <div class="p-6">
    <div class="flex justify-between gap-4">
      <span class="eyebrow">case study</span>
      <button
        id="project-close"
        class="text-2xl text-[var(--muted)]"
        aria-label="Close project"
      >
        ×
      </button>
    </div>
    <div id="project-dialog-content" class="mt-5"></div>
  </div>
</dialog>
<script is:inline>
  document.querySelectorAll('[data-thumb]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const img = e.currentTarget.dataset.thumb;
      const card = e.currentTarget.closest('[data-project]');
      const main = card?.querySelector('[data-cover]');
      if (main && img) main.src = img;
    });
  });
</script>
<script define:vars={{ projects }}>
  const dialog = document.querySelector('#project-dialog');
  const content = document.querySelector('#project-dialog-content');
  document
    .querySelectorAll('.project-open')
    .forEach((button) =>
      button.addEventListener('click', () => {
        const project = projects.find(
          (item) => item.slug === button.getAttribute('data-project')
        );
        if (!project || !content || !dialog) return;
        content.innerHTML = `<h2 class="text-3xl font-semibold">${project.title}</h2><p class="mt-4 text-[var(--muted)]">${project.result}</p><div class="mt-6 rounded-lg border border-[var(--line)] bg-[var(--bg)] p-8 text-center mono text-xs text-[var(--faint)]">architecture / media slot<br>${project.media?.length ? 'Media available in the project data.' : 'Add media under public/media/projects/' + project.slug}</div>`;
        dialog.showModal();
      })
    );
  document.querySelector('#project-close')?.addEventListener('click', () => dialog?.close());
</script>
