---
const { projects } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id="projects" class="section border-y border-[var(--line)]" data-reveal>
  <div class="container">
    <div class="section-heading">
      <div class="eyebrow">04. PROJECTS</div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2">
        Case studies from the hot path.
      </h2>
      <p>
        Problem, approach, result. No theatre—just the engineering decisions that
        moved the system.
      </p>
    </div>
    <div class="grid gap-12">
      {projects.map((project, index) => (
        <article
          class="card card-hover flex flex-col p-6"
          data-project-card
          data-project
        >
          <div class="mb-4 flex items-center justify-between gap-4">
            <span class="eyebrow rounded-full border border-[var(--line)] px-3 py-1 text-xs">{project.status}</span>
            <span class="mono text-xs text-[var(--faint)] opacity-60">
              case/{project.slug}
            </span>
          </div>
          <!--
            Future-proof note: If some projects later have coverImage
            while others don't, the grid may look unbalanced.
            Consider rendering ALL cards with consistent height
            (either all large media or all compact badge) if this happens.
          -->
          {project.coverImage ? (
            <>
              <span class="mono text-xs text-[var(--accent)] uppercase tracking-wider">
                {project.imageType === 'diagram'
                  ? 'ARCHITECTURE'
                  : project.imageType === 'screenshot'
                  ? 'UI'
                  : ''}
              </span>
              <div class="w-full aspect-[16/9] max-h-[420px] overflow-hidden rounded-lg border border-[var(--line)] mb-4">
                <img
                  data-cover
                  src={`${base}/${project.coverImage.replace(/^\//, '')}`}
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover object-top"
                />
              </div>
              {project.media?.length > 1 && (
                <div class="grid grid-cols-5 gap-2 mb-5">
                  {project.media.map((thumb) => (
                    <button
                      type="button"
                      data-thumb={`${base}/${thumb.replace(/^\//, '')}`}
                      class="group aspect-video rounded border border-[var(--line)] overflow-hidden hover:border-[var(--accent)] transition-colors"
                      aria-label={`View ${project.title} screenshot`}
                    >
                      <img
                        src={`${base}/${thumb.replace(/^\//, '')}`}
                        alt=""
                        loading="lazy"
                        class="w-full h-full object-cover object-top"
                      />
                    </button>
                  ))}
                </div>
              )}
            </>
          ) : null}
          <h3 class={`mt-5 flex items-center gap-3 text-2xl font-semibold tracking-tight ${project.coverImage ? '' : 'mt-2'}`}>
            {!project.coverImage && (() => {
              const initials = project.initials || project.title
                .split(' ')
                .filter((word) => /^[A-Z]/.test(word))
                .map((word) => word[0])
                .join('')
                .slice(0, 4)
                .toUpperCase();
              return <span class={`inline-flex min-w-[40px] min-h-[40px] items-center justify-center rounded border border-[var(--line)] px-2 py-1 mono text-[var(--accent)] ${initials.length <= 2 ? 'text-sm' : 'text-xs'}`} aria-label={`${initials} project badge`}>{initials}</span>;
            })()}
            <span>{project.title}</span>
          </h3>
          <div class="mt-6 grid gap-5 text-sm text-[var(--muted)] md:grid-cols-3">
            <div>
              <span class="mono text-xs text-[var(--accent)]">problem</span>
              <p class="mt-2">{project.problem}</p>
            </div>
            <div>
              <span class="mono text-xs text-[var(--accent)]">approach</span>
              <p class="mt-2">{project.approach}</p>
            </div>
            <div>
              <span class="mono text-xs text-[var(--accent)]">result</span>
              <p class="mt-2">{project.result}</p>
            </div>
          </div>
          <div class="mt-auto flex flex-wrap items-center gap-2 pt-7">
            <span class="mono mr-2 text-xs text-[var(--faint)]">
              {project.role}
            </span>
            {project.tech.map((tech) => (
              <span class="rounded-full border border-[var(--line)] px-2.5 py-1 mono text-[.67rem] text-[var(--muted)]">
                {tech}
              </span>
            ))}
            <button
              class="project-open ml-auto rounded-md border border-[var(--line-strong)] px-3 py-2 mono text-xs text-[var(--accent)]"
              type="button"
              data-modal-trigger
              data-modal-id={project.slug}
            >
              View case study →
            </button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<dialog
  id="project-dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="project-dialog-title"
  class="w-[min(92vw,760px)] rounded-xl border border-[var(--line-strong)] bg-[var(--surface)] p-0 text-[var(--text)] backdrop:bg-black/70"
>
  <div class="p-6">
    <div class="flex justify-between gap-4">
      <span class="eyebrow">case study</span>
      <button
        id="project-close"
        class="text-2xl text-[var(--muted)]"
        aria-label="Close case study"
      >
        ×
      </button>
    </div>
    <div id="project-dialog-content" class="mt-5"></div>
  </div>
</dialog>
<script id="project-data" type="application/json" set:html={JSON.stringify(projects)}></script>
<script is:inline>
  document.querySelectorAll('[data-thumb]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const img = e.currentTarget.dataset.thumb;
      const card = e.currentTarget.closest('[data-project]');
      const main = card?.querySelector('[data-cover]');
      if (main && img) main.src = img;
    });
  });
</script>
<script is:inline>
  const dialog = document.querySelector('#project-dialog');
  const content = document.querySelector('#project-dialog-content');
  const closeButton = document.querySelector('#project-close');
  let activeTrigger = null;
  let focusableElements = [];
  const projects = JSON.parse(document.querySelector('#project-data')?.textContent || '[]');
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  })[character]);
  const hasText = (value) => typeof value === 'string' && value.trim().length > 0;
  const hasItems = (value) => Array.isArray(value) && value.length > 0;
  const section = (title, body) => `<section class="mt-7"><h3 class="mono text-xs uppercase tracking-wider text-[var(--accent)]">${title}</h3>${body}</section>`;
  const flowMarkup = (flow) => flow.map((item, index) => `${index ? '<span class="mono text-[var(--accent)]" aria-hidden="true">→</span>' : ''}<span class="rounded border border-[var(--line)] px-3 py-2 mono text-xs text-[var(--text)]">${escapeHtml(item)}</span>`).join('');
  const metricMarkup = (metrics) => metrics.map((metric) => `<div class="flex flex-wrap items-center gap-3 mono text-sm"><span class="text-[var(--muted)]">${escapeHtml(metric.label)}</span><span class="text-[var(--muted)]">${escapeHtml(metric.before)}</span><span class="text-[var(--accent)]" aria-hidden="true">→</span><span class="text-[var(--accent)]">${escapeHtml(metric.after)}</span></div>`).join('');
  const decisionMarkup = (decisions) => decisions.map((decision) => `<article class="rounded-lg border border-[var(--line)] bg-[var(--bg)] p-4"><h4 class="font-semibold">${escapeHtml(decision.title)}</h4><p class="mt-2 text-sm text-[var(--muted)]">${escapeHtml(decision.why)}</p></article>`).join('');
  const listMarkup = (items) => `<ul class="list-disc space-y-2 pl-5 text-sm text-[var(--muted)]">${items.map((item) => `<li>${escapeHtml(item)}</li>`).join('')}</ul>`;
  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-modal-trigger]');
    if (!button) return;
    const project = projects.find((item) => item.slug === button.getAttribute('data-modal-id'));
        if (!project || !content || !dialog) return;
        activeTrigger = button;
        const sections = [
          section('Context', `<p class="text-[var(--muted)]">${escapeHtml(project.problem)}</p>`),
          hasText(project.role) ? section('My role', `<p class="text-[var(--muted)]">${escapeHtml(project.role)}</p>`) : '',
          hasItems(project.flow) && project.flow.length > 1 ? section('Flow', `<div class="flex flex-wrap items-center gap-2">${flowMarkup(project.flow)}</div>`) : '',
          hasItems(project.metrics) ? section('Before / after', `<div class="space-y-3">${metricMarkup(project.metrics)}</div>`) : '',
          hasItems(project.decisions) ? section('Key decisions', `<div class="grid gap-3">${decisionMarkup(project.decisions)}</div>`) : '',
          section('Approach', `<p class="text-[var(--muted)]">${escapeHtml(project.approach)}</p>`),
          section('Result', `<p class="text-[var(--muted)]">${escapeHtml(project.result)}</p>`),
          hasItems(project.improvements) ? section("What I'd improve", listMarkup(project.improvements)) : '',
          hasItems(project.tech) ? section('Stack', `<div class="flex flex-wrap gap-2">${project.tech.map((tech) => `<span class="rounded-full border border-[var(--line)] px-2.5 py-1 mono text-xs text-[var(--muted)]">${escapeHtml(tech)}</span>`).join('')}</div>`) : '',
          hasText(project.note) ? section('Note', `<p class="text-[var(--muted)]">${escapeHtml(project.note)}</p>`) : '',
        ].join('');
        content.innerHTML = `<h2 id="project-dialog-title" class="text-3xl font-semibold">${escapeHtml(project.title)}</h2>${sections}`;
        dialog.showModal();
        focusableElements = [closeButton, ...content.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])')].filter(Boolean);
        closeButton?.focus();
  });
  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('cancel', () => dialog.close());
  dialog?.addEventListener('close', () => {
    activeTrigger?.focus();
    activeTrigger = null;
  });
  dialog?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || focusableElements.length < 2) return;
    const first = focusableElements[0];
    const last = focusableElements[focusableElements.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
