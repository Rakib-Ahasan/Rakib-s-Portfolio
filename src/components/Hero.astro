---
const { profile } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section id="top" class="relative overflow-hidden border-b border-[var(--line)] py-20 md:py-28" data-reveal>
  <div class="pointer-events-none absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-[var(--accent)] opacity-[.08] blur-[100px]"></div>
  <div class="container grid items-center gap-14 lg:grid-cols-[1.15fr_.85fr]">
	<div>
	  <div class="eyebrow mb-6"><span class="mr-2 inline-block h-2 w-2 rounded-full bg-[var(--accent)] shadow-[0_0_12px_var(--accent)]"></span>{profile.openTo}</div>
	  <h1 class="max-w-4xl text-5xl font-bold leading-[.98] tracking-[-.06em] md:text-7xl">{profile.name}</h1>
	  <p class="mono mt-6 text-lg text-[var(--accent)] md:text-xl">{profile.title}</p>
	  <p class="mt-6 max-w-2xl text-xl leading-relaxed text-[var(--muted)]">{profile.tagline}</p>
	  <div class="mt-9 flex flex-wrap gap-3">
		<a class="rounded-lg bg-[var(--accent)] px-5 py-3 font-semibold text-[var(--bg)] transition hover:-translate-y-0.5" href="#contact">Contact me</a>
		<a class="rounded-lg border border-[var(--line-strong)] px-5 py-3 font-semibold text-[var(--text)] transition hover:-translate-y-0.5 hover:bg-[var(--accent-soft)]" href={`${base}${profile.cvPath.replace(/^\//, '')}`} download={profile.cvDownloadName}>Download CV</a>
		<a class="inline-flex items-center gap-2 rounded-lg border border-[var(--line)] px-5 py-3 text-[var(--muted)] transition hover:border-[var(--line-strong)] hover:text-[var(--accent)]" href={profile.github} target="_blank" rel="noreferrer"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>GitHub <svg class="w-4 h-4 ml-1 inline" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg></a>
		<a class="inline-flex items-center gap-2 rounded-lg border border-[var(--line)] px-5 py-3 text-[var(--muted)] transition hover:border-[var(--line-strong)] hover:text-[var(--accent)]" href={profile.linkedin} target="_blank" rel="noreferrer"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>LinkedIn <svg class="w-4 h-4 ml-1 inline" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg></a>
	  </div>
	</div>
	<div class="terminal-window card relative overflow-hidden p-1 shadow-[0_0_80px_var(--accent-soft)]">
	  <div class="flex items-center gap-2 border-b border-[var(--line)] px-4 py-3"><i class="h-2.5 w-2.5 rounded-full bg-[#ff6b6b]"></i><i class="h-2.5 w-2.5 rounded-full bg-[#ffd166]"></i><i class="h-2.5 w-2.5 rounded-full bg-[#06d6a0]"></i><span class="mono ml-3 text-xs text-[var(--faint)]">rakib.cs</span></div>
	  <div class="flex aspect-square items-center justify-center bg-[radial-gradient(circle_at_50%_35%,var(--accent-soft),transparent_55%)] p-8">
		<img src={`${base}media/profile.jpg`} alt="Portrait of Md. Rakib Ahasan" class="profile-photo h-full w-full rounded-lg object-cover" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
		<div class="hidden h-full w-full items-center justify-center rounded-lg border border-[var(--line-strong)] bg-[var(--surface-strong)] text-7xl font-bold text-[var(--accent)]" aria-label="RA initials avatar">RA</div>
	  </div>
	  <div class="mono flex justify-between border-t border-[var(--line)] px-4 py-3 text-xs text-[var(--faint)]"><span>status: shipping</span><span>UTC+6</span></div>
	</div>
  </div>
</section>
