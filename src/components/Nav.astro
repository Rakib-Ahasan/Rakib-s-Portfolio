---
const base = import.meta.env.BASE_URL;
const links = [
  ['impact', 'Impact'], ['flow', 'Performance'], ['experience', 'Experience'], ['projects', 'Projects'], ['skills', 'Skills'], ['contact', 'Contact']
];
---
<nav class="sticky top-0 z-40 border-b border-[var(--line)] bg-[color-mix(in_srgb,var(--bg)_85%,transparent)] backdrop-blur-xl" aria-label="Primary navigation">
  <div class="container flex h-16 items-center justify-between gap-4">
	<a href={`${base}#top`} class="mono text-sm font-medium text-[var(--accent)]" aria-label="Rakib Ahasan home">ra<span class="text-[var(--muted)]">/</span>backend</a>
	<div class="hidden items-center gap-5 md:flex">
	  {links.map(([id, label]) => <a class="nav-link mono text-[.68rem] uppercase tracking-wider text-[var(--muted)] transition hover:text-[var(--accent)]" href={`${base}#${id}`} data-nav-link={id}>{label}</a>)}
	</div>
	<div class="flex items-center gap-2">
	  <button class="mono rounded-md border border-[var(--line)] px-2 py-1 text-xs text-[var(--muted)] transition hover:border-[var(--line-strong)] hover:text-[var(--accent)]" id="command-button" type="button" aria-label="Open command palette">⌘K</button>
	  <button class="rounded-md border border-[var(--line)] p-2 text-[var(--muted)] hover:border-[var(--line-strong)] hover:text-[var(--accent)]" id="theme-button" type="button" aria-label="Toggle color theme"><span id="theme-icon">☼</span></button>
	  <button class="rounded-md border border-[var(--line)] p-2 text-[var(--muted)] md:hidden" id="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">☰</button>
	</div>
  </div>
  <div class="container hidden border-t border-[var(--line)] pb-3 pt-2 md:hidden" id="mobile-menu">
	{links.map(([id, label]) => <a class="block py-2 mono text-xs uppercase tracking-wider text-[var(--muted)]" href={`${base}#${id}`}>{label}</a>)}
  </div>
</nav>

<div class="fixed inset-0 z-50 hidden bg-black/60 p-4 backdrop-blur-sm" id="command-palette" role="dialog" aria-modal="true" aria-labelledby="command-title">
  <div class="mx-auto mt-[12vh] max-w-xl overflow-hidden rounded-xl border border-[var(--line-strong)] bg-[var(--surface)] shadow-2xl">
	<div class="flex items-center gap-3 border-b border-[var(--line)] px-4"><span class="mono text-[var(--accent)]">›</span><input id="command-input" class="w-full bg-transparent py-4 text-[var(--text)] outline-none" placeholder="Jump to a section or action…" aria-label="Command" /><kbd class="mono text-xs text-[var(--faint)]">Esc</kbd></div>
	<div class="p-2" id="command-results"></div>
  </div>
</div>

<script is:inline>
  const root = document.documentElement;
  const themeButton = document.querySelector('#theme-button');
  const themeIcon = document.querySelector('#theme-icon');
  const applyTheme = (theme) => { root.dataset.theme = theme; localStorage.setItem('theme', theme); if (themeIcon) themeIcon.textContent = theme === 'dark' ? '☼' : '☾'; };
  themeButton?.addEventListener('click', () => applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));
  document.querySelector('#menu-button')?.addEventListener('click', (event) => { const button = event.currentTarget; const menu = document.querySelector('#mobile-menu'); const open = menu?.classList.toggle('hidden') === false; button.setAttribute('aria-expanded', String(open)); });
  document.querySelectorAll('#mobile-menu a').forEach((link) => link.addEventListener('click', () => document.querySelector('#mobile-menu')?.classList.add('hidden')));
  const sections = [...document.querySelectorAll('main section[id]')];
  const navObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) document.querySelectorAll('[data-nav-link]').forEach((link) => link.classList.toggle('text-[var(--accent)]', link.getAttribute('data-nav-link') === entry.target.id)); }), { rootMargin: '-25% 0px -65% 0px' });
  sections.forEach((section) => navObserver.observe(section));
  const palette = document.querySelector('#command-palette'); const input = document.querySelector('#command-input'); const results = document.querySelector('#command-results');
  const commands = [['Go to impact', '#impact'], ['Go to performance', '#flow'], ['Go to experience', '#experience'], ['Go to projects', '#projects'], ['Go to skills', '#skills'], ['Go to contact', '#contact'], ['Open GitHub', 'https://github.com/Rakib-Ahasan'], ['Open LinkedIn', 'https://linkedin.com/in/rakib-ahasan'], ['Email Rakib', 'mailto:bd.rakibahasan@gmail.com'], ['Toggle theme', 'theme']];
  const renderCommands = (query = '') => { const matches = commands.filter(([label]) => label.toLowerCase().includes(query.toLowerCase())); if (results) results.innerHTML = matches.map(([label, target], index) => `<button class="command-item flex w-full items-center justify-between rounded-md px-3 py-3 text-left text-sm text-[var(--text)] hover:bg-[var(--accent-soft)]" data-target="${target}"><span>${label}</span><span class="mono text-xs text-[var(--faint)]">${index + 1}</span></button>`).join(''); results?.querySelectorAll('.command-item').forEach((button) => button.addEventListener('click', () => { const target = button.getAttribute('data-target'); if (target === 'theme') themeButton?.click(); else if (target?.startsWith('#')) document.querySelector(target)?.scrollIntoView({ behavior: 'smooth' }); else window.open(target, '_blank', 'noopener'); palette?.classList.add('hidden'); })); };
  const openPalette = () => { palette?.classList.remove('hidden'); input?.focus(); renderCommands(); }; document.querySelector('#command-button')?.addEventListener('click', openPalette); input?.addEventListener('input', () => renderCommands(input.value)); document.addEventListener('keydown', (event) => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); openPalette(); } if (event.key === 'Escape') palette?.classList.add('hidden'); }); palette?.addEventListener('click', (event) => { if (event.target === palette) palette.classList.add('hidden'); });
</script>
