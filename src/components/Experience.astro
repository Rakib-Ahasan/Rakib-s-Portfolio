---
const { experience } = Astro.props;
---
<section id="experience" class="section" data-reveal><div class="container"><div class="section-heading"><div class="eyebrow">03 / operating history</div><h2>Systems, not job titles.</h2><p>The through-line is backend ownership: understand the constraint, measure the path, ship the smallest durable fix.</p></div><div class="space-y-4">{experience.map((job, index) => <article class="grid gap-5 border-t border-[var(--line)] py-7 md:grid-cols-[220px_1fr] md:gap-10"><div><div class="mono text-xs text-[var(--accent)]">{job.period}</div><h3 class="mt-2 font-semibold">{job.company}</h3><p class="mt-1 text-sm text-[var(--muted)]">{job.context}</p></div><div><h4 class="text-xl font-semibold tracking-tight">{job.role}</h4><ul class="mt-4 space-y-3 text-[var(--muted)]">{job.bullets.slice(0, 3).map((bullet) => <li class="flex gap-3"><span class="mono text-[var(--accent)]">→</span><span>{bullet}</span></li>)}</ul>{job.bullets.length > 3 && <><div id={`exp-${index}-extra`} class="exp-extra md:block"><ul class="mt-3 space-y-3 text-[var(--muted)]">{job.bullets.slice(3).map((bullet) => <li class="flex gap-3"><span class="mono text-[var(--accent)]">→</span><span>{bullet}</span></li>)}</ul></div><button type="button" class="exp-toggle btn btn-ghost mt-4 hidden min-h-[44px] px-3 py-2 text-sm md:hidden" aria-expanded="false" aria-controls={`exp-${index}-extra`}>Show more</button></>}</div></article>)}</div></div></section>
<script is:inline>
  document.documentElement.classList.add('js');
  // Keep desktop behavior as-is: `md:block` on `.exp-extra` overrides `hidden` at md+ breakpoints.
  document.querySelectorAll('.exp-extra').forEach((target) => target.classList.add('hidden'));
  document.querySelectorAll('.exp-toggle').forEach((button) => {
    button.classList.remove('hidden');
    button.addEventListener('click', () => {
      const target = document.getElementById(button.getAttribute('aria-controls'));
      if (!target) return;
      const expanded = button.getAttribute('aria-expanded') === 'true';
      target.classList.toggle('hidden', expanded);
      button.setAttribute('aria-expanded', String(!expanded));
      button.textContent = expanded ? 'Show more' : 'Show less';
    });
  });
</script>
