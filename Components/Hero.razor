<div class="hero min-h-screen bg-gradient-to-b from-[#0a0a2e] via-[#1a1a3e] to-[#0d0d20] text-white relative overflow-hidden">
    <div class="absolute inset-0">
        <div class="absolute top-0 left-0 right-0 h-96 bg-gradient-to-b from-transparent via-[#06b6d4/10] to-transparent"></div>
    </div>

    <div class="relative z-10 flex flex-col items-center justify-center py-12 px-4 text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 tracking-tight">
            @Portfolio.Profile.Name
        </h1>
        <p class="text-lg md:text-xl text-[#8080a0] max-w-2xl mb-8 leading-relaxed">
            @Portfolio.Profile.Pitch
        </p>

        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
            <a href="@(Portfolio.Profile.CvPath ?? "/assets/Rakib_Ahasan_CV.pdf")" class="btn btn-primary px-6 py-3 rounded-lg font-medium text-lg">
                Download CV
            </a>
            <a href="#contact" class="btn btn-outline px-6 py-3 rounded-lg font-medium text-lg border-2 border-white">
                Contact
            </a>
        </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-96 bg-gradient-to-t from-transparent via-[#06b6d4/15] to-transparent"></div>
</div>

@code {
    [Inject] IPortfolioService PortfolioService { get; set; } = default!;
    private Models.PortfolioData Portfolio => _portfolio ??= PortfolioService.GetPortfolioDataAsync().Result;
    private Models.PortfolioData? _portfolio;
}