<div class="py-24 lg:py-32 bg-[#0a0a2e]">
    <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 tracking-title">Projects</h2>

        @if (Portfolio.Projects.Count == 0)
        {
            <p class="text-base text-[#707080]">No projects loaded.</p>
        }
        else
        {
            @foreach (var project in Portfolio.Projects)
            {
                <div class="project-card bg-[#15152e] rounded-xl p-6 mb-8 hover:shadow-lg hover:transition-shadow duration-300">
                    <div class="flex flex-col sm:flex-row gap-4 mb-4">
                        <div class="flex-1">
                            <h3 class="text-xl font-bold mb-2">@(project.Name)</h3>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var tech in project.Tech)
                                {
                                    <span class="tech-pill inline-block px-2.5 py-0.5 rounded text-xs font-medium bg-[#2a2a4e] text-[#6090b0]">
                                        @tech
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="w-12 h-12 rounded bg-primary flex items-center justify-center">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-primary">
                                <path d="M3 3h2l2.29 11.4L19 8l-9 6 9 6.91L3 21l2-2.91z" />
                            </svg>
                        </div>
                    </div>

                    <p class="text-base text-[#8080a0] mb-3 line-clamp-3">@(project.Problem)</p>

                    <div class="flex gap-3">
                        <div class="flex-1">
                            <h4 class="font-medium mb-2">Problem</h4>
                            <p class="text-sm text-[#606070]">@(project.Problem)</p>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-medium mb-2">Solution</h4>
                            <p class="text-sm text-[#606070]">@(project.Solution)</p>
                        </div>
                    </div>

                    <div>
                        <h4 class="font-medium mb-2">Outcome</h4>
                        <p class="text-sm text-primary">@(project.Outcome)</p>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Inject] IPortfolioService PortfolioService { get; set; } = default!;
    private Models.PortfolioData Portfolio => _portfolio ??= PortfolioService.GetPortfolioDataAsync().Result;
    private Models.PortfolioData? _portfolio;
}