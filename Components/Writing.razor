<div class="py-24 lg:py-32 bg-[#101028]">
    <div class="max-w-5xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 tracking-title">Writing</h2>

        @if (Portfolio.Articles.Count == 0)
        {
            <div class="empty-state text-center py-16">
                <svg width="64" height="64" class="mx-auto mb-4 opacity-50" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                </svg>
                <p class="text-base text-[#707080]">No articles loaded. Add dev.to links to portfolio.json to populate this section.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-2 gap-4">
                @foreach (var article in Portfolio.Articles)
                {
                    <article class="card bg-[#15152e] rounded-xl p-6 hover:shadow-lg hover:transition-shadow duration-300">
                        <h3 class="text-xl font-bold mb-2">@(article.Title)</h3>
                        <p class="text-base text-[#707080] mb-3 line-clamp-2">@(article.Summary ?? "No summary available")</p>
                        <a href="@(article.Url)" target="_blank" class="inline-flex items-center text-primary hover:underline">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="mr-1">
                                <path d="M18.89 8.95l1.41 1.41L19.88 15H5v-2.12l-4.26 4.26L7.29 6l1.41-1.41L15.38 8.95L18.89 8.95zM4.88 17.2L7.29 14.79l5.18 5.27L13 9l-5-5L4.88 17.2zM19.31 9c-.29-.16-1.01-.16-1.3 0l-3.52 3.52.7 3.81L19 15.16l-4.78 4.78.29.31.31.29L19 15.16l4.45 4.45-.3.3-.3.3z" />
                            </svg>
                            Read article
                        </a>
                    </article>
                }
            </div>
        }
    </div>
</div>

@code {
    [Inject] IPortfolioService PortfolioService { get; set; } = default!;
    private Models.PortfolioData Portfolio => _portfolio ??= PortfolioService.GetPortfolioDataAsync().Result;
    private Models.PortfolioData? _portfolio;
}