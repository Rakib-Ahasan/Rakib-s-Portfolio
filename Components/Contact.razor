<div class="py-24 lg:py-32 bg-[#0a0a2e]">
    <div class="max-w-5xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 tracking-title">Contact</h2>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="space-y-4">
                <p class="text-base text-[#8080a0]">
                    <span class="font-medium">Email:</span> @(Portfolio.Contact.Email)
                </p>
                <p class="text-base text-[#8080a0]">
                    <span class="font-medium">Phone:</span> @(Portfolio.Contact.Phone)
                </p>
            </div>

            <div class="space-y-4">
                <p class="text-base text-[#8080a0]">
                    <span class="font-medium">LinkedIn:</span> <a href="@(Portfolio.Contact.Linkedin)" target="_blank" class="text-primary hover:underline">@(Portfolio.Contact.Linkedin)</a>
                </p>
                <p class="text-base text-[#8080a0]">
                    <span class="font-medium">GitHub:</span> <a href="@(Portfolio.Contact.Github)" target="_blank" class="text-primary hover:underline">@(Portfolio.Contact.Github)</a>
                </p>
            </div>
        </div>

        <form action="https://formspree.io/f/[ADD YOUR FORMSPREE ID]" method="POST" class="contact-form grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-[#606070] mb-2">Name</label>
                    <input type="text" name="name" class="w-full px-4 py-3 rounded bg-[#1a1a3e] border border-[#303040] text-white placeholder-gray-400 focus:outline-none focus:border-primary transition" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-[#606070] mb-2">Email</label>
                    <input type="email" name="email" class="w-full px-4 py-3 rounded bg-[#1a1a3e] border border-[#303040] text-white placeholder-gray-400 focus:outline-none focus:border-primary transition" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-[#606070] mb-2">Message</label>
                    <textarea name="message" rows="4" class="w-full px-4 py-3 rounded bg-[#1a1a3e] border border-[#303040] text-white placeholder-gray-400 focus:outline-none focus:border-primary transition" required></textarea>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-full py-4 rounded-lg font-medium text-lg">
                Send Message
            </button>
        </form>
    </div>
</div>

@code {
    [Inject] IPortfolioService PortfolioService { get; set; } = default!;
    private Models.PortfolioData Portfolio => _portfolio ??= PortfolioService.GetPortfolioDataAsync().Result;
    private Models.PortfolioData? _portfolio;
}