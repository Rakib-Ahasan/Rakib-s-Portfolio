<div class="py-24 lg:py-32 bg-[#101028]">
    <div class="max-w-5xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 tracking-title">About</h2>

        <p class="text-lg mb-6 text-[#8080a0] leading-relaxed">
            @Portfolio.Summary
        </p>

        <div class="key-results grid grid-cols-2 sm:grid-cols-5 gap-2">
            @foreach (var result in Portfolio.KeyResults)
            {
                <span class="px-3 py-1.5 rounded bg-[#1a1a3e] text-sm text-[#6090b0]">
                    @result
                </span>
            }
        </div>
    </div>
</div>

@code {
    [Inject] IPortfolioService PortfolioService { get; set; } = default!;
    private Models.PortfolioData Portfolio => _portfolio ??= PortfolioService.GetPortfolioDataAsync().Result;
    private Models.PortfolioData? _portfolio;
}